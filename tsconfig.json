{
	"compilerOptions": {
    "module": "CommonJS",
		"target": "ES2022",
		"lib": [
			"ES2022",
			"DOM"
		],
		"sourceMap": true,
		"rootDir": "src",
		"outDir": "out",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"types": ["mocha", "node"]
	}
}
