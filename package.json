{
  "name": "watchdocs",
  "displayName": "watchdocs",
  "publisher": "watchdocs",
  "description": "auto detect dependencies and show offical docs",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onView:watchdocs.sidebar"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "watchdocs.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "watchdocs.scan",
        "title": "Scan Dependencies"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "watchdocs",
          "title": "WatchDocs",
          "icon": "resources/watchdocs-v2.svg"
        }
      ]
    },
    "views": {
      "watchdocs": [
        {
          "id": "watchdocs.sidebar",
          "name": "Project Docs",
          "icon": "resources/watchdocs-v2.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "dotenv": "^17.3.1"
  }
}
